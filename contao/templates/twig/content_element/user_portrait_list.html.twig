{% trans_default_domain 'contao_default' %}
{% extends "@Contao/content_element/_base.html.twig" %}

{# Add a class to the headline #}
{% set headline_attributes = attrs()
    .mergeWith(headline.attributes|default({}))
    .addClass('content-headline') %}
{% set headline = headline|merge({ 'tag_name': 'h4', 'attributes': headline_attributes }) %}

{% block content %}
    {% if items|default %}
        <div class="d-flex justify-content-start flex-wrap content-user-portrait-list--container">
            {{ items|raw }}
        </div>
    {% endif %}

    {% add to head %}
        <style{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
            .content-user-portrait-list > .content-headline {
                width: 280px;
                max-width: 100%;
                overflow-wrap: break-word;
                min-height: 60px;
            }

            .content-user-portrait-list--container {
                column-gap: 1rem;
                row-gap: 2rem;
            }
        </style>
    {% endadd %}
{% endblock %}

