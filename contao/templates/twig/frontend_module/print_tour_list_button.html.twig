{% trans_default_domain 'contao_default' %}
{% extends "@Contao/frontend_module/_base.html.twig" %}

{% set searchable = false %}

{% block content %}
    {% if watch_event_list_module|default %}
        {% set button_id = 'button_'~ data.id %}
        {% if not has_logged_in_frontend_user() %}
            {# Trigger the login modal window for not logged in users #}
            <button class="btn btn-sm btn-primary text-nowrap" data-sac-login-toggle="modal" data-sac-login-target="same-site" title="Tourliste drucken">
                <i class="ready fa-solid fa-fw fa-cloud-arrow-down"></i> Tour-Liste drucken
            </button>
        {% else %}
            <button id="{{ button_id }}" class="btn btn-sm btn-primary text-nowrap" disabled data-url title="Tourliste drucken">
                <i class="ready fa-solid fa-fw fa-cloud-arrow-down"></i>
                <i class="busy fa-solid fa-fw fa-sync fa-spin"></i> Tour-Liste drucken
            </button>
        {% endif %}
        <div class="toast-container position-fixed top-0 start-0 p-3">
            <div id="download-info-toast" class="toast" role="alert" data-bs-autohide="false" aria-live="assertive" aria-atomic="true">
                <div class="toast-header">
                    <span class="me-auto text-danger small text-wrap">
                        <i class="fa-solid fa-circle-info"></i> <strong>Hallo {{ insert_tag('user::firstname') }}!</strong>
                    </span>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
                <div class="toast-body bg-white text-wrap">
                    <small>
                        Deine Tour-Liste wird jetzt im Hintergrund für dich zusammengestellt. Das kann je nach Anzahl gewählter Touren einige Minuten Zeit beanspruchen.<br>
                        Du darfst aber in dieser Zeit gerne auf {{ app.request.getSchemeAndHttpHost() }} weitersurfen, dich aber nicht abmelden.
                        Sobald die Tour-Liste zum Downloaden bereit ist, wirst du auf dieser Webseite wieder benachrichtigt.
                    </small>
                </div>
            </div>
        </div>

        {% add to head %}
            <style{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
                .module-print-tour-list-button button .ready {
                    display: inline;
                }

                .module-print-tour-list-button button .busy {
                    display: none;
                }

                .module-print-tour-list-button button[disabled] .ready {
                    display: none;
                }

                .module-print-tour-list-button button[disabled] .busy {
                    display: inline;
                }
            </style>
        {% endadd %}
        <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>

            const eventListId = '{{ watch_event_list_module }}';
            const buttonId = '{{ button_id }}';

            document.addEventListener('DOMContentLoaded', () => {
                const TourListUtil = {
                    removeParam: function (strUrl, arrParams) {
                        const url = new URL(strUrl);
                        const params = new URLSearchParams(url.search);

                        for (const param of arrParams) {
                            params.delete(param);
                        }

                        return params.toString();
                    },
                    initDownload: function (button) {
                        button.addEventListener("click", async (e) => {
                            // Prevent multiple form submits
                            button.setAttribute('disabled', '');

                            e.preventDefault();
                            e.stopPropagation();

                            // base64 decode the url stored in the data-url attribute
                            const url = decodeURI(atob(e.currentTarget.dataset.url));

                            // Remove offset, limit and fields from param string
                            const strParams = TourListUtil.removeParam(url, ['offset', 'limit', 'fields', 'fields[]']);
                            const href1 = window.location.protocol + '//' + window.location.hostname + '/eventApi/events?' + strParams;

                            // Get the event IDS without limit and offset from the server!
                            const response = await fetch(href1);
                            const arrJSON = await response.json();
                            const arrIDS = arrJSON.meta.arrEventIds;

                            if (!arrIDS.length) {
                                alert('Die Tourliste ist leer und kann nicht gedruckt werden. Ändere die Filtereinstellungen.');
                                button.removeAttribute('disabled', '');
                                return;
                            }

                            // Add an uuid
                            const uuid = window.crypto.randomUUID();

                            // Build url for the docx/pdf controller
                            const href2 = '_print_tour_list/init_download?ids=' + arrIDS.join(',') + '&uuid=' + uuid;

                            try {
                                // Call the docx/pdf controller
                                const resp = await fetch(href2);

                                if (resp.ok) {
                                    button.removeAttribute('disabled');

                                    // Show info toast
                                    const toast = document.getElementById('download-info-toast');
                                    const toastInstance = new bootstrap.Toast(toast);
                                    toastInstance.show();

                                    (() => {
                                        {# Play a short sound to alert the user to the message #}
                                        const audio = new Audio("{{ asset('sounds/bell.mp3', 'markocupic_sac_event_tool') }}");
                                        audio.play();
                                    })();
                                }
                            } catch (e) {
                                button.removeAttribute('disabled');
                                alert('Die Tour-Liste kann nicht heruntergeladen werden.')
                            }
                        });
                    }
                }

                // Listen to sacevt::event_list.indexed_db_load event
                // and inject the last fetch url to the buttons data-url attribute
                document.addEventListener('sacevt::event_list.indexed_db_load', (e) => {
                    if (e.detail.vueInstance.elId !== '#tour-list' && !e.detail.vueInstance.lastRequestUrl) {
                        return;
                    }

                    const button = document.getElementById(buttonId);

                    if (typeof button === 'undefined' || !button) {
                        return;
                    }

                    if (typeof e.detail.vueInstance.lastRequestUrl === 'undefined' || !e.detail.vueInstance.lastRequestUrl) {
                        return;
                    }

                    if (e.detail.vueInstance.lastRequestUrl) {

                        button.removeAttribute('disabled');

                        button.dataset.url = btoa(e.detail.vueInstance.lastRequestUrl);
                        TourListUtil.initDownload(button);
                    }
                });

                // Listen to sacevt::event_list.pre_fetch event
                // and inject the last fetch url to the buttons data-url attribute
                document.addEventListener('sacevt::event_list.pre_fetch', (e) => {

                    if (e.detail.modId.toString() !== eventListId) {
                        return;
                    }

                    const button = document.getElementById(buttonId);

                    if (button && e.detail.url) {
                        button.removeAttribute('disabled');

                        button.dataset.url = btoa(e.detail.url);
                        TourListUtil.initDownload(button);
                    }
                });
            });
        </script>
    {% endif %}
{% endblock %}
