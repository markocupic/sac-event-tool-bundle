<div class="mb-4 step-indicator">
    {% set step_trans = {
        'login': '1. Login',
        'register': '2. Registrieren',
        'confirm': '3. Bestätigung',
    } %}

    {% for item in items %}
        {% set attributes = attrs()
            .addClass('checkout-step')
            .addClass(item.is_valid ? 'step--is-valid' : '')
            .addClass(item.is_current ? 'step--is-current' : '')
            .addClass(item.is_future ? 'step--is-future' : '')
            .addClass((item.is_future == false and item.is_current == false) ? 'step--is-previous' : '') %}
        <span{{ attributes }}>{{ step_trans[item.name] }}</span>
        {% if loop.last is not true %}
            <span class="step-indicator-divider"> &#10140; </span>
        {% endif %}
    {% endfor %}
</div>
