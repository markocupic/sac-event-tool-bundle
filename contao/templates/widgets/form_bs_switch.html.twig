{# Bootstrap switch variant of the checkbox form widget (see EventFilterFormController) #}
<div class="{{ [this.prefix, this.class|default]|filter(v => v)|join(' ') }}">
    <fieldset id="ctrl_{{ this.id }}" class="checkbox_container{% if this.class|default %} {{ this.class }}{% endif %}">

        {% if this.label %}
            <legend>
                {% if this.mandatory|default %}
                    <span class="invisible">{{ this.mandatoryField }} </span>{{ this.label|raw }}<span class="mandatory">*</span>
                {% else %}
                    {{ this.label|raw }}
                {% endif %}
            </legend>
        {% endif %}

        {% if hasErrors.invoke() %}
            <p class="error">{{ getErrorAsString.invoke() }}</p>
        {% endif %}

        <input type="hidden" name="{{ this.name }}" value="">

        {% for option in getOptions.invoke() %}
            {% if option.type == 'group_start' %}
                <fieldset>
                <legend>{{ option.label|raw }}</legend>
            {% endif %}

            {% if option.type == 'option' %}
                <div class="form-check form-switch">
                    <input type="checkbox" name="{{ option.name }}" id="opt_{{ option.id }}" class="form-check-input checkbox" value="{{ option.value }}"{{ option.checked|raw }}{{ option.attributes|raw }}>
                    <label class="form-check-label" id="lbl_{{ option.id }}" for="opt_{{ option.id }}">{{ option.label|raw }}</label>
                </div>
            {% endif %}

            {% if option.type == 'group_end' %}
                </fieldset>
            {% endif %}
        {% endfor %}

    </fieldset>
</div>
