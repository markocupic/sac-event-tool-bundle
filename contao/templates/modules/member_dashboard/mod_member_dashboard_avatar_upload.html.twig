{% extends '@Contao/block_unsearchable' %}

{% block content %}
    <!-- Profile picture card-->
    <div class="member-dashboard-avatar-upload">
        <div class="member-dashboard-avatar-upload--inner">
            {% if hasInfoMessage %}
                <div class="alert alert-info" role="alert">
                    {{ infoMessage }}
                </div>
            {% endif %}
            {% if hasErrorMessage %}
                {% for msg in errorMessages %}
                    <div class="alert alert-danger" role="alert">
                        {{ msg }}
                    </div>
                {% endfor %}
            {% endif %}
            <div class="card mb-4 mb-xl-0 p-0">
                {#
                <div class="card-header bg-light">Profilbild</div>
                #}
                <div class="card-body text-center">
                    <div class="member-dashboard-avatar-upload--picture-box position-relative">
                        {{ insert_tag('image::'~getAvatarResourcePath(userModel)~'?mode=crop&height=300&width=300&class=mb-2 w-100 member-dashboard-avatar-upload--image img-account-profile rounded-circle')|raw }}
                        {% if has_avatar %}
                            <button class="member-dashboard-avatar-upload--rotate-profile-image-button" data-apiurl="{{ rotate_image_url }}" title="Bild um 90° im Uhrzeigersinn drehen"><i class="fa-solid fa-clock-rotate-left" data-fa-transform="flip-h"></i></button>
                        {% endif %}
                    </div>
                    <div class="small font-italic text-muted mb-4">JPG oder PNG</div>
                    {% if not has_avatar %}
                        <button class="member-dashboard-avatar-upload--trigger-file-input-button btn btn-sm btn-primary" type="button">Profilbild uploaden</button>
                    {% endif %}
                    {% if has_avatar %}
                        <a href="{{ delete_image_url }}" class="member-dashboard-avatar-upload--delete-profile-image-button btn btn-sm btn-danger" onclick="if(!confirm('Soll dein Profilbild wirklich gelöscht werden?'))return false">Profilbild löschen</a>
                    {% endif %}
                    {% if has_avatar %}
                        <div class="mt-2">
                            <a href="{{ download_image_url }}" class="member-dashboard-avatar-upload--download-profile-image-link small">Profilbild downloaden</a>
                        </div>
                    {% endif %}
                </div>
            </div>
            {% if form|default %}
                <div class="member-dashboard-avatar-upload--form-box">
                    {{ form|raw }}
                </div>
            {% endif %}
        </div>
    </div>
    {% add to head %}
        <script src="{{ asset('js/avatar_uploader.js', 'markocupic_sac_event_tool') }}"></script>
    {% endadd %}
    {% add to body %}
        <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
            document.addEventListener('DOMContentLoaded', () => {
                const appContainer = document.querySelector('.member-dashboard-avatar-upload');
                const uploadButton = appContainer.querySelector('.member-dashboard-avatar-upload--trigger-file-input-button');
                const rotateButton = appContainer.querySelector('.member-dashboard-avatar-upload--rotate-profile-image-button');
                const fileInput = appContainer.querySelector('input[type="file"]');

                if (uploadButton) {
                    uploadButton.addEventListener('click', () => {
                        fileInput.click();
                    });
                }

                if (rotateButton) {
                    rotateButton.addEventListener('click', async (event) => {
                        event.preventDefault();
                        const button = event.currentTarget;
                        button.disabled = true;
                        const apiUrl = button.dataset.apiurl;
                        const imageElement = appContainer.querySelector('.member-dashboard-avatar-upload--image');
                        await AvatarUploader.rotateImage(imageElement, 90, apiUrl);
                        button.disabled = false;
                    });
                }

                if (fileInput) {
                    fileInput.addEventListener('change', async function () {
                        await AvatarUploader.updateFileInput(fileInput);
                        fileInput.closest('form').submit();
                    });
                }
            });
        </script>
    {% endadd %}
{% endblock %}
