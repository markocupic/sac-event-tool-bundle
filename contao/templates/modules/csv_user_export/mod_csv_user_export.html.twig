{#
This is the base template for
- backend user Export in the frontend
- frontend user Export in the frontend
#}
{% extends '@Contao/block_unsearchable' %}

{% block content %}
    {% add to head %}
        {% set attributes = attrs()
            .setIfExists('nonce', csp_nonce('script-src'))
            .set('src', asset('choices.js/scripts/choices.min.js', 'markocupic_sac_event_tool'))
        %}

        <script{{ attributes }}></script>
        <link rel="stylesheet" href="{{ asset('choices.js/styles/choices.min.css', 'markocupic_sac_event_tool') }}">
    {% endadd %}
    {{ form|raw }}
    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
        const element = document.querySelector('#ctrl_user-roles');
        const choices = new Choices(element, {
            removeItems: true,
            removeItemButton: true,
        });
    </script>
{% endblock %}
