<script<?= $this->attr()->setIfExists('nonce', $this->nonce('script-src')) ?>>
document.addEventListener("DOMContentLoaded", () => {
    "use strict";

    const elements = document.querySelectorAll('.do-not-show-row-when-empty');

    for (const element of elements) {
      if (element.innerText.trim() === '') {
        element.closest('tr').remove();
        console.log('removed row');
      }
    }
  });
</script>

<script<?= $this->attr()->setIfExists('nonce', $this->nonce('script-src')) ?>>
  document.addEventListener("DOMContentLoaded", () => {
    "use strict";

    /**
     * Initialize filter board
     * Initialize choices.js for the organizer select menu
     */
    const selectField = document.querySelector('#ctrl_userRoles');

    if (null !== selectField){
      new Choices(selectField, {
        removeItems: true,
        removeItemButton: true,
      });
    }
  });
</script>


<?php $this->endblock(); ?>
