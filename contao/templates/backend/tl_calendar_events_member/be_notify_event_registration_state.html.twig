<div id="tl_buttons">
    <a href="{{ back }}" class="header_back" title="{{ 'MSC.backBTTitle'|trans({}, 'contao_default') }}" accesskey="b">{{ 'MSC.backBT'|trans({}, 'contao_default') }}</a>
</div>

{# The Stimulus controller prevents the email from being sent twice (double click) #}
<div class="notify-event_participant_form" data-controller="sacevt--backend--prevent-double-submit">
    <h1 class="headline">{{ headline }}</h1>
    {{ form|raw }}
</div>

<style{{ attrs().setIfExists('nonce', csp_nonce('style-src')) }}>
    .notify-event_participant_form {
        border-top: 1px solid #e6e6e8;
    }

    .notify-event_participant_form .headline {
        margin: 15px 15px 40px 15px;
        font-size: 1.25rem;
        color: green;
    }

    .notify-event_participant_form .widget {
        margin-bottom: 40px;
        width: 100%;
        max-width: 800px;
    }

    .notify-event_participant_form input.text, .notify-event_participant_form textarea {
        border: 1px solid var(--form-border);
        background: var(--form-bg);
        width: 100%;
        padding: 4px;
    }

    .notify-event_participant_form label {
        display: block;
        margin: 12px 0 5px 0;
        font-weight: bold;
    }

    .notify-event_participant_form .submit {
        padding: 7px 12px;
        border: 1px solid var(--form-border);
        border-radius: 2px;
        box-sizing: border-box;
        cursor: pointer;
        background: var(--form-bg);
        transition: background .2s ease;
    }

</style>
