{# templates/user/hash_users.html.twig #}

<form id="hashForm" method="POST" action="{{ path('hash_users') }}">
    <input type="hidden" name="offset" value="0">
    <input type="hidden" name="limit" value="100">
    <input type="hidden" name="max" value="{{ max }}">
    <input type="hidden" name="REQUEST_TOKEN" value="{{ csrf_token }}">
</form>

<progress id="progressBar" max="{{ max }}" value="0"></progress>


<script>
    const form = document.getElementById('hashForm');
    const offsetInput = form.querySelector('input[name="offset"]');
    const limit = parseInt(form.querySelector('input[name="limit"]').value);
    const totalUsers = parseInt(form.querySelector('input[name="max"]'));

    async function processBatch(offset = 0) {
        const formData = new FormData(form);
        formData.set('offset', offset);

        try {
            const response = await fetch(form.action, {
                method: form.method,
                body: formData
            });

            const result = await response.json();
            console.log(result);
            let nextOffset = parseInt(offset) + parseInt(limit);

            document.getElementById('progressBar').value = nextOffset;

            if (result.success) {
                offsetInput.value = nextOffset;
                processBatch(nextOffset); // nächster Durchlauf
            } else {
                console.log('Hashing abgeschlossen oder Fehler. ' + nextOffset);
            }
        } catch (error) {
            console.error('Fehler beim Hashing:', error);
        }
    }

    // Starte den ersten Durchlauf
    processBatch(offsetInput.value);
</script>
