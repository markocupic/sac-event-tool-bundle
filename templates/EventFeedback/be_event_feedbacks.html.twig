{#
    Backend: anonymous summary of the feedbacks of an event (key "showEventFeedbacks").
    See src/Feature/EventFeedback/Controller/EventFeedbackBackendController.php
#}
<style>
    .sefb-container p, .sefb-container li { line-height: 1.5; }
    .sefb-block { display: block; }
    .sefb-title-main { margin: 20px 0; font-size: 22px !important; font-weight: bold; }
    .sefb-feedback-text, .sefb-eval-question { margin: 24px 0 10px 0 !important; }
    .sefb-eval-question { font-weight: bold; }
    .sefb-text-italic { font-style: italic; }
</style>
<div class="sefb-container content">
    <div class="widget">
        <h2 class="sefb-title-main">Event Auswertung für "{{ event.title }}"</h2>

        {% if feedback_count == 0 %}
            <div class="sefb-block sefb-feedback-text">
                <p>Zu diesem Event sind noch keine Rückmeldungen vorhanden.</p>
            </div>
        {% else %}
            <div class="sefb-block sefb-feedback-count">
                <p>Anzahl Rückmeldungen: {{ feedback_count }}</p>
            </div>

            <div><a href="{{ pdf_link|raw }}" class="tl_submit">Rückmeldungen drucken</a></div>

            {% for field in choice_fields %}
                <h2 class="sefb-block sefb-eval-question">{{ field.label }}</h2>
                <ul class="sefb-block sefb-text-italic">
                    {% for option in field.values %}
                        <li class="sefb-block">{{ option.count }}x {{ option.label }}</li>
                    {% endfor %}
                </ul>
            {% endfor %}

            {% for field in text_fields %}
                <h2 class="sefb-block sefb-eval-question">{{ field.label }}</h2>
                {% for value in field.values %}
                    <p class="sefb-block sefb-text-italic">{{ value }}</p>
                {% endfor %}
            {% endfor %}
        {% endif %}
    </div>
</div>
