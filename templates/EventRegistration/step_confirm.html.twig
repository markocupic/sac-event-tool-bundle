{% trans_default_domain 'contao_default' %}

{% set message %}
    Du bist für "{{ event_model.title }}" registriert.
    <br>
    Status: {{ event_member_model.stateOfSubscriptionTrans }}
{% endset %}
{% include '@MarkocupicSacEventTool/Alert/alert_default.html.twig'|default with {wrapper_class: 'alert-info', add_icon: true, icon_class: 'fa-solid fa-check-circle', text: message } %}

<table class="table">
    <tr>
        <td class="fw-bold">Event</td>
        <td>
            <p><a href="{{ event_model.eventUrl }}" title="zum Event">"{{ event_model.title }}"</a></p>
            <p>Event-Datum: {{ event_model.startDate|date("d.m.Y") }}</p>
            <p><a href="{{ path('sac_event_tool_download_event_ical', {'eventId': event_model.id}) }}"><span class="badge bg-primary"><i class="fa-regular fa-calendar-plus"></i> ICal</span></a></p>
        </td>
    </tr>
    <tr>
        <td class="fw-bold">Name</td>
        <td>{{ event_member_model.firstname }} {{ event_member_model.lastname }}</td>
    </tr>
    <tr>
        <td class="fw-bold">Mitglieder-Nr.</td>
        <td>{{ event_member_model.sacMemberId }}</td>
    </tr>
    <tr>
        <td class="fw-bold">Strasse</td>
        <td>{{ event_member_model.street }}</td>
    </tr>
    <tr>
        <td class="fw-bold">PLZ/Ort</td>
        <td>{{ event_member_model.postal }} {{ event_member_model.city }}</td>
    </tr>
    <tr>
        <td class="fw-bold">E-Mail-Adresse</td>
        <td>{{ event_member_model.email }}</td>
    </tr>
    <tr>
        <td class="fw-bold">Telefonnummer Festnetz</td>
        <td>{{ event_member_model.phone }}</td>
    </tr>
    <tr>
        <td class="fw-bold">Telefonnummer Mobile</td>
        <td>{{ event_member_model.mobile }}</td>
    </tr>
    <tr>
        <td class="fw-bold">Registriert am</td>
        <td>{{ event_member_model.dateAdded|date("d.m.Y H:m") }}</td>
    </tr>
    <tr>
        <td class="fw-bold">Bemerkungen</td>
        <td>{{ event_member_model.notes|nl2br }}</td>
    </tr>
    <tr>
        <td class="fw-bold">Notfallangaben</td>
        <td>{{ event_member_model.emergencyPhoneName }}, {{ event_member_model.emergencyPhone }}</td>
    </tr>
    {% if event_model.addIban %}
        <tr>
            <td class="fw-bold">Bezahlung/Vorauskasse</td>
            <td>
                <p>Bitte überweise die Teilnahmegebühren auf:</p>
                <p>
                    <span class="fw-bold">IBAN:</span>
                    <br>
                    {{ event_model.iban }}
                    <br>
                    <br>
                    <span class="fw-bold">Begünstigter:</span>
                    <br>
                    {{ event_model.ibanBeneficiary|nl2br }}
                </p>
                <p>Details dazu erhältst du per E-Mail nach dem Absenden des Anmeldeformulars.</p>
            </td>
        </tr>
    {% endif %}
</table>

{# Display a short message if the user has updated his contact/emergency data #}
{% if has_frontend_user_notifications('event_registration_controller::update_contact_data') %}
    {% set messages = get_frontend_user_notifications('event_registration_controller::update_contact_data', true) %}
    {% for message in messages %}
        <div class="mt-5">
            {% include '@MarkocupicSacEventTool/Alert/alert_default.html.twig'|default with {wrapper_class: 'alert-info', add_icon: true, icon_class: 'fa-solid fa-info-circle', text: message.messageText|nl2br } %}
        </div>
    {% endfor %}
{% endif %}

<div class="mt-5">
    {% set message %}
        <p class="my-0">In deinem <strong>Mitgliederprofil</strong> kannst du den Status deiner Anmeldung einsehen und deine Buchungen gegebenenfalls <strong>stornieren</strong>.</p>
    {% endset %}
    {% include '@MarkocupicSacEventTool/Alert/alert_default.html.twig'|default with {wrapper_class: 'alert-info', add_icon: true, icon_class: 'fa-solid fa-info-circle', text: message } %}
</div>
