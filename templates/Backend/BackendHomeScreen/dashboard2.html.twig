<div id="tl_backend_home_screen_my_events">
    <div id="tl_backend_home_screen_my_events_inner">
        <h2><i class="fa-solid fa-mountain-sun"></i> {{ 'MSC.bhs_dashb_sacEvents'|trans({}, 'contao_default') }}</h2>
        <table class="tl_listing with-border">
            {% set index = 0 %}
            {% set col_span = 10 %}
            {% for event in events %}
                {% if event.separator is defined %}
                    {% if event.separator == 'upcoming-events' %}
                        {% set index = 0 %}
                        <tr>
                            <th colspan="{{ col_span }}" class="separator">{{ 'MSC.bhs_dashb_yourUpcomingEvents'|trans({}, 'contao_default') }}</th>
                        </tr>
                        {% if has_upcoming_events is same as(false) %}
                            <tr class="even">
                                <th colspan="{{ col_span }}">{{ 'MSC.bhs_dashb_noUpcomingEventsDetected'|trans({}, 'contao_default') }}</th>
                            </tr>
                        {% endif %}
                    {% endif %}
                    {% if event.separator == 'past-events' %}
                        {% set index = 0 %}
                        <tr>
                            <th colspan="{{ col_span }}" class="separator">{{ 'MSC.bhs_dashb_yourPastEvents'|trans({}, 'contao_default') }}</th>
                        </tr>
                        {% if has_past_events is same as(false) %}
                            <tr class="even">
                                <th colspan="{{ col_span }}">{{ 'MSC.bhs_dashb_noPastEventsDetected'|trans({}, 'contao_default') }}</th>
                            </tr>
                        {% endif %}
                    {% endif %}
                {% else %}
                    {% set index = index + 1 %}
                    {% set odd_or_even = index%2 == 0 ? ' event' : ' odd' %}
                    <tr class="hover-row {{ event.row_class }}{{ odd_or_even }}">
                        <td class="my-events-badge-col --text-align-left --vertical-align-top">
                            <div class="--d-flex --flex-row --flex-wrap --row-gap-1 --align-items-center">
                                {{ event.badge|raw }}
                            </div>
                        </td>
                        <td class="my-events-title-col --text-align-left --vertical-align-top">
                            <div class="my-events-title-col--container">
                                <div class="my-events-title-col--date">
                                    {{ event.date }}
                                </div>
                                <div class="my-events-title-col--icon-and-title --d-flex --flex-row --column-gap-1">
                                    {{ event.state_icon|raw }}
                                    <a href="{{ event.href_event }}" class="--ms-1 --text-underline" title="{{ 'MSC.bhs_dashb_editEvent'|trans({}, 'contao_default') }}"><strong>{{ event.title }}</strong></a>
                                </div>
                                {% if event.release_level is not empty %}
                                    <div class="my-events-title-col--fs">
                                        <a href="{{ event['operations']['be-dashb-op--event-listing']['href'] }}" class="--text-underline" title="{{ 'MSC.bhs_dashb_editReleaseLevel'|trans({}, 'contao_default') }}">({{ event.release_level }})</a>
                                    </div>
                                {% endif %}
                            </div>
                        </td>
                        <td class="my-events-operation-col --vertical-align-top">
                            <div class="--d-flex --flex-row --column-gap-1 --align-items-center">
                                <ul class="--d-flex --flex-row --column-gap-1">
                                    {% for op_name,op in event.operations %}
                                        {% if op.primary|default %}
                                            <li class="{{ op_name }}">
                                                {% if op.href|default %}
                                                    <a href="{{ op.href }}" class="--d-flex" title="{{ op.title }}"{{ attrs().mergeWith(op.link_attributes|default({})) }}>
                                                        <i class="{{ op.icon_class }}"></i>
                                                    </a>
                                                {% else %}
                                                    <span class="--d-flex">
                                                        <i class="{{ op.icon_class }} filter-brightened" title="{{ op.title }}"></i>
                                                    </span>
                                                {% endif %}
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                                {# Wrap the operation links in a dropdown #}
                                <div data-controller="sacevt--operation-dropdown" class="dropdown">
                                    <button data-sacevt--operation-dropdown-target="toggle" title="Operationen anzeigen" class="dropdown-toggle" type="button" aria-expanded="false">
                                        <i class="fa-solid fa-ellipsis-vertical fa-rotate-90"></i>
                                    </button>
                                    <ul data-sacevt--operation-dropdown-target="menu" class="dropdown-menu">
                                        {% for op_name,op in event.operations %}
                                            {% if not op.primary|default %}
                                                <li class="{{ op_name }} dropdown-item">
                                                    {% if op.href|default %}
                                                        <a href="{{ op.href }}" class="dropdown-item --d-flex --flex-row --flex-nowrap --column-gap-2 --text-nowrap" title="{{ op.title }}"{{ attrs().mergeWith(op.link_attributes|default({})) }}>
                                                            <i class="{{ op.icon_class }}"></i><span class="my-events-operation-col--item-label">{{ op.label }}</span>
                                                        </a>
                                                    {% else %}
                                                        <span class="dropdown-item --d-flex --flex-row --flex-nowrap --column-gap-2 --text-nowrap">
                                                    <i class="{{ op.icon_class }} filter-brightened" title="{{ op.title }}"></i><span class="my-events-operation-col--item-label">{{ op.label }}</span>
                                                </span>
                                                    {% endif %}
                                                </li>
                                            {% endif %}
                                        {% endfor %}
                                    </ul>
                                </div>
                                {# End dropdown #}
                            </div>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
            {% if load_more_past_events_url %}
                <tr>
                    <th colspan="{{ col_span }}" class="vertical-align-top">
                        <div class="tl_submit_container"><a class="tl_submit" data-action="contao--scroll-offset#store" href="{{ load_more_past_events_url }}">{{ 'MSC.bhs_dashb_loadMorePastEventsBtnLbl'|trans({}, 'contao_default') }}</a></div>
                    </th>
                </tr>
            {% endif %}
        </table>

        <h2>{{ 'MSC.bhs_dashb_guidesAndTutorials'|trans({}, 'contao_default') }}</h2>
        <p>{{ 'MSC.bhs_dashb_guidesAndTutorialsText'|trans({}, 'contao_default')|raw }}</p>
    </div>
</div>

<style{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
    .dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown-toggle {
        padding: 0.5rem 1rem;
        background-color: transparent;
        border: none;
        cursor: pointer;
        border-radius: 0.25rem;
    }

    @media (min-width: 576px) {
        .dropdown-toggle {
            display: none;
        }
    }

    ul.dropdown-menu {
        position: absolute;
        top: 100%;
        right: 0;
        width: auto;
        min-width: 200px;
        max-width: 500px;
        padding: 0.5rem;
        background-color: white;
        border: 1px solid #ccc;
        border-radius: 0.25rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        z-index: 1000;
        display: none;
        flex-direction: column;
        flex-wrap: nowrap;
        column-gap: .25rem;
    }

    ul.dropdown-menu.show {
        display: flex;
        flex-direction: column;
        row-gap: 1rem;
        @media (min-width: 576px) {
            row-gap: 0;
            flex-direction: row;
        }
    }

    ul.dropdown-menu a:hover * {
        color: var(--contao) !important;
    }

    @media (min-width: 576px) {
        ul.dropdown-menu {
            display: flex;
            flex-direction: row;
            column-gap: .25rem;
            row-gap: 0;
            min-width: initial;
            padding: 0;
            border: none;
            border-radius: 0;
            box-shadow: none;
            position: initial;
            background-color: transparent;
            z-index: initial;
        }

        ul.dropdown-menu.show {
            display: flex;
        }
    }

    li.dropdown-item * {
        color: #212529;
        text-decoration: none;
        text-align: left;
        line-height: 1.25;
    }

    @media (min-width: 576px) {
        li.dropdown-item {
            display: block;
            color: #212529;
            text-decoration: none;
            text-align: left;
            line-height: 1;
        }
    }

    @media (min-width: 576px) {
        .my-events-operation-col--item-label {
            display: none;
        }
    }

</style>

