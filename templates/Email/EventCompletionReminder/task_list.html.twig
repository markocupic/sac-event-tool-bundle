{#
    To-do list for the event completion reminder (HTML version).
    Rendered into the notification token ##task_list_html##.

    Variables:
    - open_tasks: list<OpenTask> (eventId, title, eventType, endDate, role, tasks: list<TaskItem>)
    - cancel_hint_urls: array<eventId, url> link to the event edit form (courses and general events only)

    Task labels: the HTML label MSC.instructor_post_event_task_html.<task name> is used if it exists
    (may contain HTML), otherwise the text label (TaskItem.label).
    Link text: MSC.instructor_post_event_task_link.<task name>, e.g. "Zur Teilnehmerliste".
    If it does not exist, the whole label is rendered as link.
#}
{% trans_default_domain 'contao_default' %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
    {% for open_task in open_tasks %}
        <tr>
            <td style="padding:10px 0;border-bottom:1px solid #dddddd;vertical-align:top;">
                <strong>{{ open_task.endDate|date('d.m.Y') }} – {{ open_task.title }}</strong>
                {% if open_task.role == 'registration_coordinator' %}
                    <span style="color:#666666;">({{ ('MSC.instructor_post_event_task_role.' ~ open_task.role)|trans }})</span>
                {% endif %}
                <ul style="margin:6px 0 0 0;padding-left:20px;">
                    {% for task in open_task.tasks %}
                        {# Label: HTML label if it exists, otherwise the (escaped) text label #}
                        {% set html_label_key = 'MSC.instructor_post_event_task_html.' ~ task.name %}
                        {% set label = html_label_key|trans != html_label_key ? html_label_key|trans : task.label|e %}
                        {# Link text, e.g. "Zur Teilnehmerliste" #}
                        {% set link_text_key = 'MSC.instructor_post_event_task_link.' ~ task.name %}
                        {% if link_text_key|trans != link_text_key %}
                            <li style="margin:2px 0;">{{ label|raw }}: <a href="{{ task.url }}">{{ link_text_key|trans }}</a></li>
                        {% else %}
                            <li style="margin:2px 0;"><a href="{{ task.url }}">{{ label|raw }}</a></li>
                        {% endif %}
                    {% endfor %}
                </ul>
                {% if cancel_hint_urls[open_task.eventId] is defined %}
                    <p style="margin:6px 0 0 0;color:#666666;">{{ 'MSC.instructor_post_event_task_cancel_hint'|trans }} <a href="{{ cancel_hint_urls[open_task.eventId] }}">{{ 'MSC.instructor_post_event_task_cancel_hint_link'|trans }}</a></p>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
</table>
