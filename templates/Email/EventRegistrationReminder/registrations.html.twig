{#
    List of unconfirmed registrations for the event registration reminder (HTML version).
    Rendered into the notification token ##registrations_html##.

    Variables:
    - events: list<PendingEvent> (eventId, title, eventType, overdueRegistrations, recentRegistrations: list<PendingRegistration>)
    - member_list_urls: array<eventId, url> link to the registration list of the event
#}
{% trans_default_domain 'contao_default' %}
{# Macros do not inherit trans_default_domain: the domain is passed explicitly #}
{% macro registration_item(registration) %}
    <li style="margin:2px 0;">{{ ('MSC.serr_participant_' ~ registration.gender)|trans({}, 'contao_default') }} {{ registration.firstname }} {{ registration.lastname }}, {{ 'MSC.serr_sac_member_id'|trans([registration.sacMemberId], 'contao_default') }} ({{ 'MSC.serr_days_registered'|trans([registration.daysRegistered], 'contao_default') }})</li>
{% endmacro %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
    {% for event in events %}
        <tr>
            <td style="padding:10px 0;border-bottom:1px solid #dddddd;vertical-align:top;">
                <strong>{{ ('MSC.' ~ event.eventType)|trans }}: {{ event.title }}</strong>
                <ul style="margin:6px 0 0 0;padding-left:20px;">
                    {% for registration in event.overdueRegistrations %}
                        {{ _self.registration_item(registration) }}
                    {% endfor %}
                </ul>
                {% if event.recentRegistrations is not empty %}
                    <p style="margin:8px 0 0 0;">{{ 'MSC.serr_these_registrations_are_also_pending'|trans }}</p>
                    <ul style="margin:4px 0 0 0;padding-left:20px;">
                        {% for registration in event.recentRegistrations %}
                            {{ _self.registration_item(registration) }}
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if member_list_urls[event.eventId] is defined %}
                    <p style="margin:8px 0 0 0;"><a href="{{ member_list_urls[event.eventId] }}">{{ 'MSC.serr_link_member_list'|trans }}</a></p>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
</table>
